pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Validate HTML') {
            steps {
                sh '''
                    # simple sanity check — fails build if key files are missing
                    test -f home.html
                    test -f ug.html
                    test -f pg.html
                '''
                // optional: install html-validate or tidy for real linting
                // sh 'npx html-validate *.html'
            }
        }

        stage('Package') {
            steps {
                sh 'zip -r site.zip *.html *.png'
                archiveArtifacts artifacts: 'site.zip', fingerprint: true
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    # example: copy to a web server path or S3 / Netlify / etc.
                    rsync -avz *.html *.png user@yourserver:/var/www/html/
                '''
            }
        }
    }
}